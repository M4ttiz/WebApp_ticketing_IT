# Copy this file to .env and fill values for production
DATABASE_URL=postgresql://ticketing_user:YOUR_PASSWORD@localhost:5432/ticketing_db?schema=public
JWT_ACCESS_SECRET=change_me_64_chars_random
JWT_REFRESH_SECRET=change_me_64_chars_random_different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=5000
NODE_ENV=production
APP_URL=https://ticketing.example.com
CORS_ORIGIN=https://ticketing.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="IT Ticketing <noreply@example.com>"
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
