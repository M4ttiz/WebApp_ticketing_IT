// ============================================
// Prisma Schema — IT Ticketing System
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────

enum Role {
  user
  viewer
  technician
  admin
}

enum Priority {
  BASSA
  MEDIA
  ALTA
  CRITICA
}

enum TicketStatus {
  APERTO
  IN_LAVORAZIONE
  IN_ATTESA
  RISOLTO
  CHIUSO
  RIFIUTATO
}

// ─── Models ────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  firstName          String    @map("first_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               Role      @default(user)
  department         String?   @db.VarChar(100)
  isActive           Boolean   @default(true) @map("is_active")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  ticketsRequested Ticket[]        @relation("TicketRequester")
  ticketsAssigned  Ticket[]        @relation("TicketAssignee")
  messages         TicketMessage[]
  history          TicketHistory[]
  attachments      Attachment[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  assets           Asset[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tickets Ticket[]

  @@map("categories")
}

model Ticket {
  id           Int          @id @default(autoincrement())
  ticketNumber String       @unique @map("ticket_number") @db.VarChar(20)
  title        String       @db.VarChar(255)
  description  String       @db.Text
  categoryId   Int          @map("category_id")
  priority     Priority     @default(MEDIA)
  status       TicketStatus @default(APERTO)
  requesterId  String       @map("requester_id")
  assigneeId   String?      @map("assignee_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  closedAt     DateTime?    @map("closed_at")

  // Relations
  category    Category        @relation(fields: [categoryId], references: [id])
  requester   User            @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages    TicketMessage[]
  history     TicketHistory[]
  attachments Attachment[]
  auditLogs   AuditLog[]
  assets      TicketAsset[]

  @@index([status])
  @@index([priority])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([categoryId])
  @@map("tickets")
}

model TicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  authorId   String   @map("author_id")
  content    String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketHistory {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    String   @map("user_id")
  action    String   @db.VarChar(255)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@map("ticket_history")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int?     @map("ticket_id")
  messageId    Int?     @map("message_id")
  uploaderId   String   @map("uploader_id")
  filename     String   @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  path         String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  ticket   Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message  TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User           @relation(fields: [uploaderId], references: [id])

  @@index([ticketId])
  @@index([messageId])
  @@map("attachments")
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    String   @map("user_id")
  action    String   @db.VarChar(255)
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  ticketId  Int?     @map("ticket_id")
  title     String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── Asset Inventory ──────────────────────────────────────────────────

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  STAMPANTE
  ACCESS_POINT
  SERVER
  SWITCH
  ROUTER
  TELEFONO
  TABLET
  ALTRO
}

enum AssetStatus {
  DISPONIBILE
  IN_USO
  IN_MANUTENZIONE
  DISMESSO
  GUASTO
}

model Asset {
  id             String        @id @default(uuid())
  name           String        @db.VarChar(255)
  category       String        @db.VarChar(100)
  brand          String?       @db.VarChar(100)
  model          String?       @db.VarChar(100)
  serialNumber   String?       @unique @map("serial_number") @db.VarChar(100)
  assetTag       String?       @unique @map("asset_tag") @db.VarChar(100)
  status         AssetStatus   @default(DISPONIBILE)
  location       String?       @db.VarChar(200)
  assignedTo     String?       @map("assigned_to") @db.VarChar(200)
  assignedUserId String?       @map("assigned_user_id") @db.VarChar(36)
  purchaseDate   DateTime?     @map("purchase_date")
  warrantyExpiry DateTime?     @map("warranty_expiry")
  notes          String?       @db.Text
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  macAddress     String?       @map("mac_address") @db.VarChar(17)
  osVersion      String?       @map("os_version") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  assignedUser User?         @relation(fields: [assignedUserId], references: [id])
  tickets      TicketAsset[]

  @@index([category])
  @@index([status])
  @@index([assignedUserId])
  @@map("assets")
}

model TicketAsset {
  id        String   @id @default(uuid())
  ticketId  Int      @map("ticket_id")
  assetId   String   @map("asset_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([ticketId, assetId])
  @@index([ticketId])
  @@index([assetId])
  @@map("ticket_assets")
}
